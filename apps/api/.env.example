# =============================================================================
# 库存自动化管理系统 V2/V3 — 环境变量配置示例
# =============================================================================
#
# 注意：
# - 此文件仅供说明，Python 不会自动加载 .env 文件
# - 环境变量需要通过终端、系统服务或部署配置（如 systemd、Docker、IIS 等）提供
# - 请勿将真实密钥提交到 Git 仓库
# - .env.example 可以提交到 Git，真实的 .env 已被 .gitignore 排除
#
# 使用方法：
#   本地开发：在终端中逐行 set / export，或由 IDE 运行配置注入
#   生产部署：由 systemd EnvironmentFile / Docker env / IIS 配置提供
# =============================================================================

# 运行环境：development（本地开发）或 production（正式生产）
INVENTORY_ENV=development

# JWT 签名密钥
# - 本地开发：可使用任意值，或留空使用内置开发默认密钥（会输出警告）
# - 正式生产：必须设置为强随机字符串（建议 64 字符以上）
# - 注意：修改密钥会使所有已登录用户的 token 失效，但不影响账号密码和业务数据
INVENTORY_JWT_SECRET_KEY=replace-with-a-local-or-production-secret

# CORS 允许的来源（逗号分隔）
# - 本地开发：Vite dev server 默认端口
# - 生产同源部署（Nginx 同时提供前端 dist 和 /api 代理）：可显式设为空
#   设为空 = 不开放任何跨域来源，此时跨域请求会被浏览器拦截（同源部署时无需 CORS）
INVENTORY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 热重载开关（true/false）
# - 仅影响 python main.py 启动方式
# - 使用 uvicorn 命令行启动时不依赖此变量
# - 生产环境建议保持 false
APP_RELOAD=false
